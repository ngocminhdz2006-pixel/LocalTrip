<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>

<c:set var="activeTripPath"
       value="${requestScope['javax.servlet.forward.servlet_path']}"/>

<c:if test="${empty activeTripPath}">
    <c:set var="activeTripPath"
           value="${pageContext.request.servletPath}"/>
</c:if>

<c:set var="overviewTabActive"
       value="${activeTripPath == '/trip/detail'}"/>

<c:set var="preferenceTabActive"
       value="${activeTripPath == '/preferences'
                or fn:startsWith(activeTripPath, '/preferences/')}"/>

<c:set var="comboTabActive"
       value="${activeTripPath == '/combos'
                or fn:startsWith(activeTripPath, '/combos/')
                or activeTripPath == '/recommendations'}"/>

<c:set var="itineraryTabActive"
       value="${activeTripPath == '/itinerary'
                or fn:startsWith(activeTripPath, '/itinerary/')}"/>

<c:set var="expenseTabActive"
       value="${activeTripPath == '/expenses'
                or fn:startsWith(activeTripPath, '/expenses/')}"/>

<c:set var="settleTabActive"
       value="${activeTripPath == '/settlement'}"/>

<c:set var="fundTabActive"
       value="${activeTripPath == '/group-fund'}"/>

<nav class="lt-trip-nav" aria-label="Trip planning tabs">
    <div class="lt-trip-nav-scroll">
        <a class="lt-trip-nav-link ${overviewTabActive ? 'is-active' : ''}"
           aria-current="${overviewTabActive ? 'page' : 'false'}"
           href="${pageContext.request.contextPath}/trip/detail?tripId=${trip.id}">
            Overview
        </a>

        <a class="lt-trip-nav-link ${preferenceTabActive ? 'is-active' : ''}"
           aria-current="${preferenceTabActive ? 'page' : 'false'}"
           href="${pageContext.request.contextPath}/preferences?tripId=${trip.id}">
            Preferences
        </a>

        <a class="lt-trip-nav-link ${comboTabActive ? 'is-active' : ''}"
           aria-current="${comboTabActive ? 'page' : 'false'}"
           href="${pageContext.request.contextPath}/combos?tripId=${trip.id}">
            Combos / AI Suggest
        </a>

        <a class="lt-trip-nav-link ${itineraryTabActive ? 'is-active' : ''}"
           aria-current="${itineraryTabActive ? 'page' : 'false'}"
           href="${pageContext.request.contextPath}/itinerary?tripId=${trip.id}">
            Itinerary
        </a>

        <a class="lt-trip-nav-link ${expenseTabActive ? 'is-active' : ''}"
           aria-current="${expenseTabActive ? 'page' : 'false'}"
           href="${pageContext.request.contextPath}/expenses?tripId=${trip.id}">
            Expenses
        </a>

        <a class="lt-trip-nav-link ${settleTabActive ? 'is-active' : ''}"
           aria-current="${settleTabActive ? 'page' : 'false'}"
           href="${pageContext.request.contextPath}/settlement?tripId=${trip.id}">
            Settle
        </a>

        <a class="lt-trip-nav-link ${fundTabActive ? 'is-active' : ''}"
           aria-current="${fundTabActive ? 'page' : 'false'}"
           href="${pageContext.request.contextPath}/group-fund?tripId=${trip.id}">
            Group Fund
        </a>
    </div>
</nav>

<style>
    .lt-trip-nav {
        margin: 18px 0;
    }
    .lt-trip-nav-scroll {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px;
        border: 1px solid #dce7df;
        border-radius: 16px;
        background: #ffffff;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }
    .lt-trip-nav-scroll::-webkit-scrollbar {
        display: none;
    }
    .lt-trip-nav-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 8px 14px;
        border-radius: 11px;
        color: #65776d;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        flex-shrink: 0;
        transition: all 0.15s ease;
    }
    .lt-trip-nav-link:hover {
        color: #1e5942;
        background: #f1f7f3;
    }
    .lt-trip-nav-link.is-active {
        background: #e4f0e8;
        color: #1e5942;
        font-weight: 700;
    }
</style>
